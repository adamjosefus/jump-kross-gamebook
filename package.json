{
  "name": "gamebook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @gamebook/web dev",
    "build": "pnpm --filter @gamebook/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "storybook": "pnpm --filter @gamebook/web storybook",
    "build:vercel": "pnpm build && node scripts/build-vercel.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
