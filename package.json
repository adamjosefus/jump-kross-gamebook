{
  "name": "gamebook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @gamebook/web dev",
    "build": "pnpm --filter @gamebook/web build",
    "test": "vitest run",
    "test:story": "vitest run --project story",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "storybook": "pnpm --filter @gamebook/web storybook",
    "build-storybook": "pnpm --filter @gamebook/web build-storybook",
    "build:vercel": "pnpm build && node scripts/build-vercel.ts"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^26.6.6",
    "oxfmt": "0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
